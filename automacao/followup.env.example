# Referencia SEM credenciais reais. Nao e carregada automaticamente.
# Reutilizar conexoes/segredos existentes do filho, conforme FOLLOWUP-TYPESCRIPT.md.
AUTOMACAO_HABILITADA=false
AUTOMACAO_FOLLOWUP_HABILITADO=false
AUTOMACAO_FOLLOWUP_INTERVALO_MINUTOS=2
AUTOMACAO_FOLLOWUP_TAMANHO_PAGINA=100
AUTOMACAO_FOLLOWUP_RETENCAO_DIAS=90
AUTOMACAO_FOLLOWUP_HTTP_TIMEOUT_MS=15000

# Vazio usa CRM/default Estrutural. Femina: fmna_followup_sim / fmna_followup_nao.
AUTOMACAO_FOLLOWUP_BOTAO_SIM_ID=
AUTOMACAO_FOLLOWUP_BOTAO_NAO_ID=

# Fallback somente quando CRM responde sem regras, restrito a um lead.
AUTOMACAO_FOLLOWUP_TESTE_LOCAL_HABILITADO=false
AUTOMACAO_FOLLOWUP_TESTE_LEAD_ID=
AUTOMACAO_FOLLOWUP_TESTE_MINUTOS=10
AUTOMACAO_FOLLOWUP_TESTE_TEXTO=

# Seguranca de homologacao: sem numeros cadastrados, nenhum envio permitido.
WHATSAPP_RESTRICAO_NUMEROS_HABILITADA=true
WHATSAPP_NUMEROS_PERMITIDOS=
