# Stack principal: estas credenciais ja existem nas envs do crm-teste.
# Este arquivo nao contem segredos reais. Nao alterar o .env.example local preenchido.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
N8N_DB_NAME=
N8N_DB_USER=
N8N_DB_PASSWORD=

# Novos banco e usuario, distintos dos dois acima.
AUTOMACAO_DB_NAME=crm_teste_automacao
AUTOMACAO_DB_USER=crm_teste_automacao_app
AUTOMACAO_DB_PASSWORD=
AUTOMACAO_DB_SCHEMA=public
AUTOMACAO_DB_POOL_MAX=3

# Stack principal: conecta automaticamente a rede privada existente.
# AUTOMACAO_REDE_CRM e usado SOMENTE no Compose separado alternativo.
AUTOMACAO_REDE_CRM=homologao-crmteste-ecbf4s_synapse-internal
AUTOMACAO_CRM_URL=http://synapse-backend-internal:8080
# Dominio NOVO: nao reutilizar crm-teste, n8n-teste ou Evolution.
AUTOMACAO_PAINEL_DOMINIO=painel-automacao-hml.187.77.47.30.sslip.io
AUTOMACAO_ROUTER_PREFIX=automacao-hml
AUTOMACAO_TOKEN=
AUTOMACAO_HABILITADA=false
AUTOMACAO_FOLLOWUP_HABILITADO=false
AUTOMACAO_MEMORY_LIMIT=768m
SYNAPSE_TIMEZONE=America/Sao_Paulo

# Stack principal: desligado por padrao em todos os filhos.
# Na homologacao, somente apos imagem publicada e deploy autorizado, usar 1/1/true.
AUTOMACAO_REPLICAS=0
AUTOMACAO_PROVISIONAR_REPLICAS=0
AUTOMACAO_PAINEL_HABILITADO=false
# Opcional: digest da imagem publicada da automacao, COM prefixo @sha256:.
# Vazio preserva SYNAPSE_IMAGE_TAG; nao inicia build automaticamente.
# Nao inventar um hash: obter o digest real no resultado da publicacao.
AUTOMACAO_IMAGE_DIGEST=
