{
  "name": "@synapse/automacao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:painel",
    "build:painel": "vite build --config painel/vite.config.ts",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.painel.json",
    "test": "tsx --test test/*.test.ts",
    "test:runtime": "node --test test/runtime.test.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "fastify": "5.12.8",
    "flatted": "3.4.4",
    "lucide": "1.70.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.7"
  }
}
