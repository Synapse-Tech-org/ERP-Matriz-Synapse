    {
      "parameters": {
        "jsCode": "// Devolve a transcricao de audio como mensagem textual para o EV-01.\nconst entrada = $('Preparar entrada midia').first().json;\nconst variaveis = $('Variaveis processamento midias').first().json;\nconst transcricao = String($('Transcrever audio').first().json.text ?? '').trim();\nconst texto = transcricao || String(variaveis.texto_audio_falha ?? '').trim();\nreturn [{\n  json: {\n    processar: true,\n    payload: {\n      ...entrada,\n      texto,\n      tipo: 'AUDIO',\n      midia_processada: { processada: Boolean(transcricao), origem: 'AUDIO', transcricao }\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1888,
        784
      ],
      "id": "fab6b185-5ae9-4f6e-9612-41b6a04d49ba",
      "name": "Retornar audio transcrito"
    },
    {
      "parameters": {
        "jsCode": "// Devolve a descricao da imagem junto da legenda, se existir.\nconst entrada = $('Preparar entrada midia').first().json;\nconst variaveis = $('Variaveis processamento midias').first().json;\nconst descricao = String($('Descrever imagem').first().json.content ?? '').trim();\nconst legenda = String(entrada.media?.caption ?? '').trim();\nconst partes = [String(variaveis.texto_imagem_prefixo ?? '').trim()].filter(Boolean);\nif (legenda) partes.push(String(variaveis.texto_imagem_legenda_prefixo ?? '') + legenda);\nif (descricao) partes.push(String(variaveis.texto_imagem_descricao_prefixo ?? '') + descricao);\nconst texto = partes.join(String.fromCharCode(10));\nreturn [{\n  json: {\n    processar: true,\n    payload: {\n      ...entrada,\n      texto,\n      tipo: 'IMAGEM',\n      midia_processada: { processada: Boolean(descricao), origem: 'IMAGEM', descricao, legenda }\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1888,
        944
      ],
      "id": "87d73265-b943-48db-b237-3206f77c2b1d",
      "name": "Retornar imagem descrita"
    },
    {
      "parameters": {
        "jsCode": "// Devolve o texto extraido do documento como mensagem textual.\nconst entrada = $('Preparar entrada midia').first().json;\nconst variaveis = $('Variaveis processamento midias').first().json;\nconst textoExtraido = String($('Extrair texto documento').first().json.text ?? '').trim();\nconst nomeArquivo = String(entrada.media?.filename ?? '').trim();\nconst partes = [String(variaveis.texto_documento_prefixo ?? '').trim()].filter(Boolean);\nif (nomeArquivo) partes.push(String(variaveis.texto_documento_arquivo_prefixo ?? '') + nomeArquivo);\nif (textoExtraido) partes.push(String(variaveis.texto_documento_extraido_prefixo ?? '') + textoExtraido);\nconst texto = textoExtraido\n  ? partes.join(String.fromCharCode(10))\n  : String(variaveis.texto_documento_falha ?? '').trim();\nreturn [{\n  json: {\n    processar: true,\n    payload: {\n      ...entrada,\n      texto,\n      tipo: 'DOCUMENTO',\n      midia_processada: { processada: Boolean(textoExtraido), origem: 'DOCUMENTO', texto_extraido: textoExtraido, arquivo: nomeArquivo }\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1888,
        1104
      ],
      "id": "6fc9e45e-b53c-4813-83ee-30730949fab8",
      "name": "Retornar documento extraido"
    },
    {
      "parameters": {
        "content": "## Processamento de midias\n\nRecebe texto/audio/imagem/documento do EV-00 e devolve sempre um payload textual para o EV-01.\n\nAudio: baixa da Meta e transcreve.\nImagem: baixa da Meta e descreve.\nDocumento: baixa da Meta e tenta extrair PDF.\n\nA Meta e a OpenAI usam credenciais cadastradas, sem token fixo no JSON.",
