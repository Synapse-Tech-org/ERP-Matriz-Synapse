      "parameters": {
        "jsCode": "// Normaliza os campos de texto e midia para os proximos nodes.\n// Este workflow devolve sempre um payload textual para o EV-01.\nconst evento = $('When Executed by Another Workflow').first().json.evento ?? {};\nconst tipo = String(evento.tipo ?? '').toUpperCase();\nconst media = evento.media ?? {};\nconst mediaId = String(media.id ?? evento.media_id ?? '').trim();\n\nreturn [{\n  json: {\n    ...evento,\n    tipo,\n    texto_original: String(evento.texto ?? '').trim(),\n    media_id: mediaId,\n    media: {\n      id: mediaId,\n      mime_type: String(media.mime_type ?? '').trim(),\n      sha256: String(media.sha256 ?? '').trim(),\n      filename: String(media.filename ?? '').trim(),\n      caption: String(media.caption ?? evento.texto ?? '').trim()\n    }\n  }\n}];"
      },
